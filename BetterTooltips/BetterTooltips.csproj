<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 = mesmo alvo dos assemblies do Unity 2022.3 (Stolen Realm) -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>BetterTooltips</AssemblyName>
    <RootNamespace>BetterTooltips</RootNamespace>
    <!-- PKG-2: FONTE UNICA DE VERSAO. Este <Version> manda. Os outros dois lugares que
         carregam versao sao ESPELHOS e sao CONFERIDOS antes de empacotar
         (tools/pack-thunderstore.py): o version_number do manifest.json e o literal do
         [BepInPlugin(...)] no Plugin.cs. Depois de subir a versao aqui, rode o
         empacotador com a opcao de sincronizar versao (ver docs/README.md, secao
         "Fonte unica de versao"). -->
    <Version>0.1.2</Version>
    <Description>Melhora textos, tooltips e descrições do Stolen Realm.</Description>
    <!-- Não copiar as DLLs referenciadas para a saída: elas já existem no jogo/BepInEx -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referência ao BepInEx 5 (copiada do perfil do r2modman) -->
    <Reference Include="BepInEx">
      <HintPath>..\lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Unity 2022.3 divide o UnityEngine em módulos: a fachada UnityEngine.dll
         reencaminha os tipos para UnityEngine.CoreModule.dll (onde vive o MonoBehaviour) -->
    <Reference Include="UnityEngine">
      <HintPath>..\lib\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\lib\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony (HarmonyX) — para interceptar métodos do jogo -->
    <Reference Include="0Harmony">
      <HintPath>..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Código do jogo — para referenciar os tipos internos (OptionsManager etc.).
         Referência de compilação apenas: NUNCA distribuir nem modificar esta DLL. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Odin/Sirenix — o Assembly-CSharp usa o serializador Odin em vários tipos -->
    <Reference Include="Sirenix.Serialization">
      <HintPath>..\lib\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization.Config">
      <HintPath>..\lib\Sirenix.Serialization.Config.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.OdinInspector.Attributes">
      <HintPath>..\lib\Sirenix.OdinInspector.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Utilities">
      <HintPath>..\lib\Sirenix.Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- DEPLOY-2: OPT-IN EXPLICITO. O deploy NAO acontece por omissao.
       O padrao (DeployToBepInEx=false) e definido na RAIZ em Directory.Build.props:
       um `dotnet build` comum NAO copia nada para o perfil do r2modman. Para
       INSTALAR de proposito, peca pelo nome:
           dotnet build -p:DeployToBepInEx=true
       (e o que o modo instalar-no-perfil do tools/release-check.sh faz.)
       O caminho usa $(USERPROFILE) (env var do Windows) + o perfil Default do mod manager.
       Se o jogo estiver aberto, a cópia falha (arquivo em uso) — feche o jogo antes de buildar. -->
  <Target Name="DeployToBepInEx" AfterTargets="Build" Condition="'$(DeployToBepInEx)' == 'true'">
    <PropertyGroup>
      <BepInExPluginsDir>$(USERPROFILE)\AppData\Roaming\r2modmanPlus-local\StolenRealm\profiles\Default\BepInEx\plugins\$(AssemblyName)\</BepInExPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(BepInExPluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPluginsDir)" />
    <Message Importance="high" Text="INFRA-1: $(TargetFileName) copiado para $(BepInExPluginsDir)" />
  </Target>

</Project>
