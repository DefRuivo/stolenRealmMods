<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 = mesmo alvo dos assemblies do Unity 2022.3 (Stolen Realm) -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>RoguelikeDebugger</AssemblyName>
    <RootNamespace>RoguelikeDebugger</RootNamespace>
    <!-- PKG-2: FONTE UNICA DE VERSAO. Este <Version> manda. Os outros dois lugares que
         carregam versao sao ESPELHOS e sao CONFERIDOS antes de empacotar
         (tools/pack-thunderstore.py): o version_number do manifest.json e o literal do
         [BepInPlugin(...)] no Plugin.cs. Depois de subir a versao aqui, rode o
         empacotador com a opcao de sincronizar versao (ver docs/README.md, secao
         "Fonte unica de versao"). -->
    <Version>0.1.0</Version>
    <Description>Logs de investigação de mecânicas do Stolen Realm (loot, Gold, Experience, eventos).</Description>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\lib\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\lib\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>..\lib\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization.Config">
      <HintPath>..\lib\Sirenix.Serialization.Config.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.OdinInspector.Attributes">
      <HintPath>..\lib\Sirenix.OdinInspector.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Utilities">
      <HintPath>..\lib\Sirenix.Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- INFRA-1: deploy automático após o build — copia a DLL para o perfil do r2modman.
       O caminho usa $(USERPROFILE) (env var do Windows) + o perfil Default do mod manager.
       Se o jogo estiver aberto, a cópia falha (arquivo em uso) — feche o jogo antes de buildar.
       PKG-5: para PULAR o deploy (ex.: buildar Release sem sobrescrever a DLL que
       está no perfil do r2modman), passe -p:DeployToBepInEx=false na linha de comando. -->
  <Target Name="DeployToBepInEx" AfterTargets="Build" Condition="'$(DeployToBepInEx)' != 'false'">
    <PropertyGroup>
      <BepInExPluginsDir>$(USERPROFILE)\AppData\Roaming\r2modmanPlus-local\StolenRealm\profiles\Default\BepInEx\plugins\$(AssemblyName)\</BepInExPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(BepInExPluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPluginsDir)" />
    <Message Importance="high" Text="INFRA-1: $(TargetFileName) copiado para $(BepInExPluginsDir)" />
  </Target>

</Project>
