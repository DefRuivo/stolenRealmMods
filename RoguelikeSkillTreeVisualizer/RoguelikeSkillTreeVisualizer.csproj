<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>RoguelikeSkillTreeVisualizer</AssemblyName>
    <RootNamespace>RoguelikeSkillTreeVisualizer</RootNamespace>
    <!-- PKG-2: FONTE UNICA DE VERSAO. Este <Version> manda. Os outros dois lugares que
         carregam versao sao ESPELHOS e sao CONFERIDOS antes de empacotar
         (tools/pack-thunderstore.py): o version_number do manifest.json e a const
         Version do Plugin.cs (usada pelo [BepInPlugin(...)]). Depois de subir a versao
         aqui, rode o empacotador com a opcao de sincronizar versao (ver docs/README.md,
         secao "Fonte unica de versao"). -->
    <Version>0.3.1</Version>
    <Description>Botao na tela Select Party e no HUD da run (ao lado do Ping Button) que abre a Skill Tree nativa em modo somente leitura.</Description>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\lib\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\lib\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\lib\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\lib\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\lib\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- RSTV-11a: `Input.GetKeyDown` (o atalho de teclado, lido cru) vive em
         UnityEngine.InputLegacyModule — o mesmo modulo que o proprio KeybindManager.Update usa
         (`Input.GetKey`/`Input.GetKeyDown`, l.133299/133255). Sem esta referencia: CS0103 "Input". -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\lib\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TextMeshPro">
      <HintPath>..\lib\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>..\lib\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule">
      <HintPath>..\lib\UnityEngine.TextCoreTextEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>..\lib\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization.Config">
      <HintPath>..\lib\Sirenix.Serialization.Config.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.OdinInspector.Attributes">
      <HintPath>..\lib\Sirenix.OdinInspector.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Utilities">
      <HintPath>..\lib\Sirenix.Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- DEPLOY-2: OPT-IN EXPLICITO. O deploy NAO acontece por omissao.
       O padrao (DeployToBepInEx=false) e definido na RAIZ em Directory.Build.props:
       um `dotnet build` comum NAO copia nada para o perfil do r2modman. Para
       INSTALAR de proposito, peca pelo nome: dotnet build -p:DeployToBepInEx=true
       (PKG-6: a propriedade e a MESMA dos outros mods — antes era `SkipDeploy` —
       para quem empacota (tools/pack-for-friends.sh, scripts/package.ps1) passar uma
       flag so para todos; esses empacotadores passam `=false`, que com o opt-in e o
       padrao de qualquer forma.) -->
  <Target Name="DeployToBepInEx" AfterTargets="Build" Condition="'$(DeployToBepInEx)' == 'true'">
    <PropertyGroup>
      <PluginsDir>$(USERPROFILE)\AppData\Roaming\r2modmanPlus-local\StolenRealm\profiles\Default\BepInEx\plugins\$(AssemblyName)\</PluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)" />
    <Message Importance="high" Text="Deploy: $(TargetFileName) copiado para $(PluginsDir)" />
  </Target>

</Project>
