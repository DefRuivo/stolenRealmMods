{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KIT13 scenario v1 — data only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "api", "id", "adapter", "steps"],
  "properties": {
    "schema": {"const": "KIT13/scenario/1"},
    "api": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$", "maxLength": 64},
    "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$", "maxLength": 64},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "op", "target", "timeout_s"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S"},
          "op": {"enum": ["menu", "tela", "condicao"]},
          "target": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
          "timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 60}
        }
      }
    }
  },
  "$comment": "Runtime validator additionally enforces duplicate JSON keys, unique step IDs, UTF8/65536-byte limit, total <=120s and KIT11 known condition vocabulary. Host checks adapter and authorization separately."
}
