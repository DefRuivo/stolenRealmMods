      "xml": "<Project>\n  <Target\n      Name=\"DeployToBepInEx\"\n      AfterTargets=\"Build\">\n    <Copy SourceFiles=\"$(TargetPath)\" DestinationFolder=\"$(USERPROFILE)\\AppData\\Roaming\\r2modmanPlus-local\\StolenRealm\\profiles\\Default\\BepInEx\\plugins\\X\\\\\" />\n  </Target>\n</Project>\n"
    },
    {
      "nome": "condition_antiga_neq_false",
      "esperado": "reprova",
      "motivo": "a Condition ANTIGA (\"!= 'false'\") que fazia o build cru instalar — nao e opt-in",
      "xml": "<Project>\n  <Target Name=\"DeployToBepInEx\" AfterTargets=\"Build\" Condition=\"'$(DeployToBepInEx)' != 'false'\">\n    <Copy SourceFiles=\"$(TargetPath)\" DestinationFolder=\"$(USERPROFILE)\\AppData\\Roaming\\r2modmanPlus-local\\StolenRealm\\profiles\\Default\\BepInEx\\plugins\\X\\\\\" />\n  </Target>\n</Project>\n"
    },
