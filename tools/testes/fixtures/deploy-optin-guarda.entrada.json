      "esperado": "aceita",
      "motivo": "Condition de opt-in certa numa linha so — o caso normal dos 6 mods",
      "xml": "<Project>\n  <Target Name=\"DeployToBepInEx\" AfterTargets=\"Build\" Condition=\"'$(DeployToBepInEx)' == 'true'\">\n    <Copy SourceFiles=\"$(TargetPath)\" DestinationFolder=\"$(USERPROFILE)\\AppData\\Roaming\\r2modmanPlus-local\\StolenRealm\\profiles\\Default\\BepInEx\\plugins\\X\\\\\" />\n  </Target>\n</Project>\n"
    },
    {
      "nome": "optin_valido_multilinha_condition_linha2",
      "esperado": "aceita",
      "motivo": "FURO A (lado que reprovava falso): tag multi-linha com a Condition VALIDA na 2a linha",
      "xml": "<Project>\n  <Target Name=\"DeployToBepInEx\" AfterTargets=\"Build\"\n          Condition=\"'$(DeployToBepInEx)' == 'true'\">\n    <Copy SourceFiles=\"$(TargetPath)\" DestinationFolder=\"$(USERPROFILE)\\AppData\\Roaming\\r2modmanPlus-local\\StolenRealm\\profiles\\Default\\BepInEx\\plugins\\X\\\\\" />\n  </Target>\n</Project>\n"
    },
