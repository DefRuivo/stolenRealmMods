      "esperado": "aceita",
      "motivo": "FURO B consertado: o MESMO alvo de outro nome, agora com o opt-in — nao pode reprovar",
      "xml": "<Project>\n  <Target Name=\"DeployToScripts\" AfterTargets=\"Build\" Condition=\"'$(DeployToBepInEx)' == 'true'\">\n    <Copy SourceFiles=\"$(TargetPath)\" DestinationFolder=\"$(USERPROFILE)\\AppData\\Roaming\\r2modmanPlus-local\\StolenRealm\\profiles\\Default\\BepInEx\\scripts\\X\\\\\" />\n  </Target>\n</Project>\n"
    },
